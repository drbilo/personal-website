---
import { Picture } from 'astro:assets';
import heroPhoto from '../assets/chris.png';
---

<section class="hero">
  <div class="hero-background"></div>
  <div class="hero-content container">
    <div class="hero-text">
      <h1 class="hero-title">Hey, I'm Chris Bennett.</h1>
      <p class="hero-role">Senior Product Manager based in Bangkok, Thailand</p>
      <p class="hero-tagline">
        I've helped scale <a href="https://screencloud.com/" target="_blank" rel="noopener noreferrer" class="highlight sketchy-link">ScreenCloud</a> from $3.5M to $31M ARR by shipping products
        that solve real customer problems. Currently leading hardware product strategy
        across 100K+ devices. And yes, I can play more than just Wonderwall.
      </p>
      <div class="hero-cta">
        <a href="#experience" class="btn">See How I Drive Growth</a>
        <a href="#contact" class="btn btn-outline">Let's Talk Product Strategy</a>
      </div>
    </div>
    <div class="hero-image">
      <Picture
        src={heroPhoto}
        formats={['avif', 'webp']}
        widths={[200, 280, 380, 560, 760]}
        sizes="(max-width: 480px) 200px, (max-width: 768px) 280px, 380px"
        alt="Chris Bennett, Senior Product Manager"
        class="hero-photo sketchy-border"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="scroll-indicator" aria-hidden="true">
    <span>Scroll</span>
    <!-- Hand-drawn arrow -->
    <svg class="doodle-arrow-down" viewBox="0 0 24 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 2 L12 32" stroke="var(--color-pencil)" stroke-width="2" stroke-linecap="round"/>
      <path d="M5 25 L12 35 L19 25" stroke="var(--color-pencil)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh; /* Fallback */
    min-height: 100dvh;
    display: flex;
    align-items: center;
    position: relative;
    padding: clamp(6rem, 12vh, 8rem) 0 4rem;
    padding-top: calc(clamp(6rem, 12vh, 8rem) + env(safe-area-inset-top, 0px));
    overflow: visible; /* Allow sketchy border to extend outside */
  }

  /* Fallback for older browsers */
  @supports not (min-height: 100dvh) {
    .hero {
      min-height: -webkit-fill-available;
    }
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(ellipse at 20% 80%, rgba(233, 69, 96, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 20%, rgba(196, 163, 90, 0.18) 0%, transparent 50%),
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    z-index: -1;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(4rem, 8vw, 8rem);
    align-items: center;
  }

  .hero-text {
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.5vw, 5rem);
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-md);
  }

  .hero-role {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
    letter-spacing: -0.01em;
  }

  .hero-tagline {
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-text);
    max-width: 560px;
    margin-bottom: var(--space-xl);
  }

  .highlight {
    color: var(--color-accent);
    font-weight: var(--font-weight-semibold);
  }

  .hero-cta {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: fadeInUp 0.8s ease-out 0.2s both;
    position: relative;
    overflow: visible;
  }

  /* Ensure Picture component wrapper doesn't clip */
  .hero-image picture {
    overflow: visible;
    display: block;
  }

  .hero-photo {
    width: clamp(280px, 25vw, 380px);
    height: clamp(280px, 25vw, 380px);
    border-radius: 50%;
    object-fit: cover;
    object-position: center top; /* Ensure face is visible, not cropped */
    position: relative;
    z-index: 1;
    overflow: visible;
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    animation: fadeInUp 0.8s ease-out 0.6s both;
  }

  .scroll-indicator span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  .scroll-indicator .doodle-arrow-down {
    width: 24px;
    height: 40px;
    animation: arrowBounce 2s ease-in-out infinite;
  }

  @keyframes arrowBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator .doodle-arrow-down {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .hero {
      align-items: flex-start;
      /* Explicit padding for mobile: 72px nav + 40px breathing room */
      padding-top: calc(112px + env(safe-area-inset-top, 0px));
    }

    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-tagline {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-cta {
      justify-content: center;
    }

    .hero-image {
      order: -1;
      align-items: flex-start; /* Override vertical centering */
    }

    .hero-photo {
      width: 280px;
      height: 280px;
      margin-top: 1.5rem; /* Space for sketchy border pseudo-elements */
    }
  }

  @media (max-width: 768px) {
    .hero-photo {
      width: 260px;
      height: 260px;
    }

    .scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-photo {
      width: 200px;
      height: 200px;
    }
  }
</style>
