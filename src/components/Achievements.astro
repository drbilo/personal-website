---
const achievements = [
  {
    metric: '9×',
    label: 'ARR Growth',
    description: 'Helped grow ScreenCloud from $3.5M to $31M ARR through product-market fit.'
  },
  {
    metric: 'Studio',
    label: 'Product Launch',
    description: 'Led the complete rewrite of ScreenCloud from the ground up using modern web standards.'
  },
  {
    metric: '3',
    label: 'Hardware Teams',
    description: 'Leading SCOS, PIXI, and Players Platform product roadmaps and delivery.'
  },
  {
    metric: '100K+',
    label: 'Devices Managed',
    description: 'Product leadership across SCOS, PIXI, and Players Platform hardware ecosystem.'
  }
];
---

<section id="achievements" class="section section-alt">
  <div class="container">
    <h2 class="section-title fade-in">
      Key Achievements
      <svg class="wavy-underline" viewBox="0 0 120 12" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M2 6 Q15 2 30 6 T60 6 T90 6 T118 6" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" fill="none"/>
      </svg>
    </h2>

    <div class="achievements-grid">
      {achievements.map((achievement, index) => (
        <article class="achievement-card fade-in" style={`animation-delay: ${index * 0.1}s`}>
          <!-- Hover star -->
          <svg class="hover-star" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2 L14 9 L21 9 L16 14 L18 21 L12 17 L6 21 L8 14 L3 9 L10 9 Z"
                  stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <div class="achievement-metric">{achievement.metric}</div>
          <h3 class="achievement-label">{achievement.label}</h3>
          <p class="achievement-description">{achievement.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .achievement-card:last-child {
    grid-column: 2;
  }

  .achievement-card {
    background: linear-gradient(135deg, var(--color-bg) 0%, rgba(233, 69, 96, 0.02) 100%);
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-lg);
    border: 2px solid transparent;
    text-align: left;
    transition: all var(--transition-base);
    position: relative;
    overflow: visible;
  }

  .achievement-card .hover-star {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 28px;
    height: 28px;
    opacity: 0;
    transform: scale(0.8) rotate(0deg);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .achievement-card:hover .hover-star {
    opacity: 1;
    transform: scale(1) rotate(15deg);
  }

  .achievement-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .achievement-card:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.08),
      0 0 0 2px var(--color-accent);
  }

  .achievement-card:hover::before {
    transform: scaleX(1);
  }

  .achievement-metric {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 900;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: var(--space-sm);
    letter-spacing: -0.03em;
    text-shadow: 0 2px 8px rgba(233, 69, 96, 0.15);
  }

  .achievement-label {
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
    line-height: 1.3;
  }

  .achievement-description {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .achievements-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .achievement-card:last-child {
      grid-column: 1 / -1;
      max-width: 400px;
      justify-self: center;
    }
  }

  @media (max-width: 768px) {
    .achievements-grid {
      grid-template-columns: 1fr;
    }

    .achievement-card:last-child {
      grid-column: auto;
      max-width: none;
    }

    .achievement-card {
      padding: var(--space-lg);
      text-align: center;
    }

    .achievement-card .hover-star {
      top: -8px;
      right: -8px;
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .achievement-card .hover-star {
      transition: opacity 0.1s ease;
      transform: scale(1) rotate(15deg);
    }
  }
</style>
