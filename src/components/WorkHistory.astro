---
const experiences = [
  {
    company: 'ScreenCloud',
    role: 'Senior Product Manager - Hardware',
    period: 'Oct 2025 - Present',
    description: 'Leading product roadmap and delivery across three hardware teams: SCOS (enterprise Linux devices), PIXI (Android devices), and Players Platform.',
    highlights: [
      'Partner with leadership to define development cycles and drive day-to-day execution',
      'Manage supplier relationships in China, overseeing stock levels and future hardware development',
      'Champion stability as a core product principle across all hardware offerings'
    ],
    current: true,
    caseStudy: {
      challenge: 'Managing a complex hardware ecosystem across 100K+ devices with varying capabilities, while coordinating with overseas suppliers and maintaining enterprise-grade reliability.',
      approach: 'Established a stability-first product philosophy, implemented rigorous testing protocols, and built strong supplier relationships through regular communication and on-site visits.',
      results: [
        { metric: 'Device Uptime', description: 'Maintained 99.9% fleet reliability across all hardware platforms' },
        { metric: 'Supply Chain', description: 'Reduced lead times by building redundant supplier relationships' },
        { metric: 'Team Alignment', description: 'Unified three hardware teams under consistent development cycles' }
      ],
      learnings: 'Hardware product management requires balancing long development cycles with customer urgency. Building trust with suppliers is as important as building trust with customers.'
    }
  },
  {
    company: 'ScreenCloud',
    role: 'Senior Product Manager - CMS',
    period: 'Aug 2022 - Oct 2025',
    description: 'Shaped product direction and methodologies to optimize development processes for the content management system.',
    highlights: [
      'Led development of a new go-to-market strategy focused on customer-centric continuous discovery',
      'Collaborated with product managers to align opportunities and solutions with business objectives',
      'Worked closely with engineering and tech leads to ensure efficient product delivery'
    ],
    current: false,
    caseStudy: {
      challenge: 'The CMS had grown organically without a clear discovery process, leading to feature bloat and misaligned priorities with actual customer needs.',
      approach: 'Introduced continuous discovery practices, including weekly customer interviews, opportunity mapping, and outcome-based roadmapping to align the team around customer problems rather than solutions.',
      results: [
        { metric: 'Discovery Cadence', description: 'Established weekly customer touchpoints across the product team' },
        { metric: 'Feature Adoption', description: 'Increased new feature adoption rates through better problem validation' },
        { metric: 'Team Efficiency', description: 'Reduced time-to-value by focusing on highest-impact opportunities' }
      ],
      learnings: 'Changing team methodologies requires patience and leading by example. Show the value of discovery through small wins before pushing for larger process changes.'
    }
  },
  {
    company: 'ScreenCloud',
    role: 'Product Manager',
    period: 'Mar 2019 - Sep 2022',
    description: 'Product Manager for industry-leading digital signage company, driving growth and finding product-market fit.',
    highlights: [
      'Helped grow the company from $3.5M ARR to over $12M ARR',
      'Communicated daily with customers to find pain points and shape solutions',
      'Implemented data collection projects with Tableau and FullStory'
    ],
    current: false,
    caseStudy: {
      challenge: 'Scaling from startup to growth stage required understanding which customer segments drove the most value and which product features enabled retention.',
      approach: 'Built a data-driven approach combining quantitative analytics (Tableau, FullStory) with qualitative research (daily customer calls) to identify patterns in successful customers.',
      results: [
        { metric: '3x ARR Growth', description: 'Contributed to scaling from $3.5M to $12M ARR' },
        { metric: 'Data Infrastructure', description: 'Built analytics foundation that informed product decisions' },
        { metric: 'Customer Insights', description: 'Established direct customer feedback loops that shaped roadmap' }
      ],
      learnings: 'The best product decisions come from combining quantitative data with qualitative understanding. Numbers tell you what is happening; conversations tell you why.'
    }
  },
  {
    company: 'Assumption College Primary',
    role: 'Computer Studies Teacher',
    period: 'Apr 2016 - Mar 2019',
    description: 'Transformed computer education curriculum and introduced programming to primary students.',
    highlights: [
      'Rewrote entire curriculum single-handedly to include Computer Science topics',
      'Started a Computer Club teaching Scratch programming and creative coding',
      'Introduced robotics building with iPad programming for STEM classes'
    ],
    current: false,
    caseStudy: {
      challenge: 'The existing computer curriculum focused on basic office software, leaving students unprepared for a technology-driven future and unengaged in classes.',
      approach: 'Redesigned the entire curriculum to introduce computational thinking, visual programming with Scratch, and hands-on robotics, making learning tangible and exciting.',
      results: [
        { metric: 'Curriculum Overhaul', description: 'Created comprehensive K-6 computer science curriculum from scratch' },
        { metric: 'Student Engagement', description: 'Computer Club became one of the most popular extracurricular activities' },
        { metric: 'STEM Foundation', description: 'Introduced robotics and programming to hundreds of students' }
      ],
      learnings: 'Teaching is product management for education. Understanding your users (students), iterating on delivery, and measuring outcomes are universal skills.'
    }
  }
];
---

<section id="experience" class="section">
  <div class="container">
    <h2 class="section-title fade-in">
      Experience
      <svg class="wavy-underline" viewBox="0 0 120 12" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M2 6 Q15 2 30 6 T60 6 T90 6 T118 6" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" fill="none"/>
      </svg>
    </h2>

    <div class="timeline">
      {experiences.map((exp, index) => (
        <article class={`timeline-item fade-in ${exp.current ? 'current' : ''}`} style={`animation-delay: ${index * 0.1}s`}>
          <div class="timeline-marker">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2 Q20 3 22 12 Q21 20 12 22 Q4 21 2 12 Q3 4 12 2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/>
            </svg>
          </div>
          <div class="timeline-content">
            {exp.current && <span class="current-badge">Current Role</span>}
            <div class="timeline-header">
              <div>
                <h3 class="company-name">{exp.company}</h3>
                <p class="role-title">{exp.role}</p>
              </div>
              <span class="period">{exp.period}</span>
            </div>
            <p class="role-description">{exp.description}</p>
            <ul class="highlights-list">
              {exp.highlights.map(highlight => (
                <li>{highlight}</li>
              ))}
            </ul>

            {exp.caseStudy && (
              <details class="case-study">
                <summary class="case-study__trigger">
                  <span>View Case Study</span>
                  <svg class="case-study__icon" aria-hidden="true" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
                  </svg>
                </summary>

                <div class="case-study__content">
                  <div class="case-study__inner">
                    <h4>The Challenge</h4>
                    <p>{exp.caseStudy.challenge}</p>

                    <h4>My Approach</h4>
                    <p>{exp.caseStudy.approach}</p>

                    <h4>Impact & Results</h4>
                    <ul class="impact-metrics">
                      {exp.caseStudy.results.map(r => (
                        <li><strong>{r.metric}:</strong> {r.description}</li>
                      ))}
                    </ul>

                    <h4>Key Learnings</h4>
                    <p>{exp.caseStudy.learnings}</p>
                  </div>
                </div>
              </details>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    padding-left: var(--space-xl);
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      to bottom,
      var(--color-accent) 0%,
      var(--color-accent) 30%,
      var(--color-warm-gray) 70%,
      transparent 100%
    );
    border-radius: 2px;
    box-shadow: 0 0 12px rgba(233, 69, 96, 0.2);
  }

  .timeline-item {
    position: relative;
    padding-bottom: var(--space-2xl);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-xl) - 10px);
    top: 0;
    width: 22px;
    height: 22px;
    color: var(--color-warm-gray);
    transition: all var(--transition-base);
    z-index: 1;
  }

  .timeline-marker svg {
    width: 100%;
    height: 100%;
  }

  .timeline-item.current .timeline-marker {
    color: var(--color-accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      filter: drop-shadow(0 0 0 rgba(233, 69, 96, 0));
    }
    50% {
      transform: scale(1.15);
      filter: drop-shadow(0 0 8px rgba(233, 69, 96, 0.4));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-item.current .timeline-marker {
      animation: none;
    }
  }

  .timeline-item:hover .timeline-marker {
    transform: scale(1.3);
    color: var(--color-accent);
  }

  .timeline-content {
    background-color: var(--color-bg);
    padding: var(--space-lg) var(--space-xl);
    border-radius: var(--radius-lg);
    border: 2px solid transparent;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .timeline-item.current .timeline-content {
    border-color: rgba(233, 69, 96, 0.2);
    box-shadow: var(--shadow-md), 0 0 20px rgba(233, 69, 96, 0.08);
    transform: scale(1.02);
  }

  .timeline-item:hover .timeline-content {
    box-shadow: var(--shadow-md);
    border-color: rgba(233, 69, 96, 0.1);
  }

  .current-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-accent) 0%, #d63851 100%);
    color: white;
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-md);
    box-shadow: 0 2px 8px rgba(233, 69, 96, 0.3);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .company-name {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.02em;
  }

  .timeline-item.current .company-name {
    color: var(--color-accent);
  }

  .role-title {
    font-size: 1.1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin: 0;
  }

  .period {
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, rgba(233, 69, 96, 0.08) 100%);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-full);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .timeline-item.current .period {
    background: linear-gradient(135deg, rgba(233, 69, 96, 0.1) 0%, rgba(233, 69, 96, 0.05) 100%);
    color: var(--color-accent);
    border-color: rgba(233, 69, 96, 0.2);
  }

  .role-description {
    margin-bottom: var(--space-md);
    font-size: 1rem;
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .highlights-list li {
    position: relative;
    padding-left: var(--space-lg);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    transition: color var(--transition-fast);
  }

  .highlights-list li:hover {
    color: var(--color-text);
  }

  .highlights-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 12px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    border-radius: 1px;
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: var(--space-lg);
    }

    .timeline-marker {
      left: calc(-1 * var(--space-lg) - 10px);
      width: 20px;
      height: 20px;
    }

    .timeline-header {
      flex-direction: column;
    }

    .period {
      align-self: flex-start;
    }

    .timeline-content {
      padding: var(--space-lg);
    }
  }
</style>
